# Copy this file to .env.local and replace each placeholder value.
# Use a publishable/anon key. Never put a service_role key in a desktop app.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Public HTTPS endpoint of the FloatCode collaboration service.
VITE_FLOATCODE_API_URL=https://collab.YOUR_DOMAIN.com
# Guest landing page served by the collaboration service.
VITE_FLOATCODE_JOIN_URL=https://collab.YOUR_DOMAIN.com/join
