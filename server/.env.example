SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never add this value to Vite variables or the desktop app.
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
# Generate with: openssl rand -base64 48
FLOATCODE_COLLAB_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FLOATCODE_PUBLIC_WS_URL=wss://collab.example.com
FLOATCODE_ALLOWED_ORIGINS=null,file://,http://127.0.0.1:5173
# Public DMG/ZIP URL shown when a guest has not installed FloatCode yet.
FLOATCODE_DOWNLOAD_URL=https://downloads.example.com/FloatCode-latest.dmg
FLOATCODE_DATA_DIR=./data/yjs
PORT=1234
